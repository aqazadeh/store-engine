<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        ProductSpecificationAssignment (List<> inside ProductRoot).
        Stores per-product specification values; owned by the product aggregate.
    -->
    <changeSet id="009-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_specification_assignment"/>
            </not>
        </preConditions>

        <createTable tableName="product_specification_assignment">
            <column name="product_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_prod_spec_asgn_product"
                             references="product(id)"/>
            </column>
            <column name="specification_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_prod_spec_asgn_specification"
                             references="product_specification(id)"/>
            </column>
            <column name="value" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="product_specification_assignment"
                columnNames="product_id, specification_id"
                constraintName="pk_product_specification_assignment"/>

        <rollback>
            <dropTable tableName="product_specification_assignment"/>
        </rollback>
    </changeSet>

    <changeSet id="009-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_prod_spec_asgn_specification_id"/>
            </not>
        </preConditions>

        <createIndex tableName="product_specification_assignment"
                     indexName="idx_prod_spec_asgn_specification_id">
            <column name="specification_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_specification_assignment"
                       indexName="idx_prod_spec_asgn_specification_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
