<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="012-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_price"/>
            </not>
        </preConditions>

        <createTable tableName="product_price">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_product_price"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>

            <column name="variant_id" type="UUID">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_product_price_variant"
                             foreignKeyName="fk_product_price_variant"
                             references="product_variant(id)"/>
            </column>
            <column name="min_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="max_price" type="NUMERIC(19, 4)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="product_price"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
