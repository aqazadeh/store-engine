<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="variant_key"/>
            </not>
        </preConditions>

        <createTable tableName="variant_key"
                     remarks="VariantKeyRoot aggregate — dimension types for product variants (e.g. Color, Size)">
            <column name="id" type="UUID" remarks="Primary key">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_variant_key"/>
            </column>
            <column name="name" type="VARCHAR(20)" remarks="Variant dimension name (5–20 chars, unique)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_variant_key_name"/>
            </column>
            <column name="description" type="VARCHAR(500)" remarks="Human-readable explanation of the variant dimension">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1" remarks="Optimistic lock version">
                <constraints nullable="false"/>
            </column>
            <column name="process_status" type="VARCHAR(20)" defaultValue="COMPLETED"
                    remarks="Outbox process state: IN_PROGRESS | FAILED | COMPLETED | ROLL_BACKED">
                <constraints nullable="false"/>
            </column>
            <column name="row_status" type="VARCHAR(20)" defaultValue="ACTIVE"
                    remarks="Logical lifecycle: ACTIVE | HIDDEN | ARCHIVED | DELETED">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ" remarks="Record creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ" remarks="Last modification timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="variant_key"/>
        </rollback>
    </changeSet>

    <changeSet id="006-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_variant_key_row_status"/>
            </not>
        </preConditions>

        <createIndex tableName="variant_key" indexName="idx_variant_key_row_status">
            <column name="row_status"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="variant_key" indexName="idx_variant_key_row_status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
