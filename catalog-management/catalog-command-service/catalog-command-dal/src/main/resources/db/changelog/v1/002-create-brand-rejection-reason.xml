<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="brand_rejection_reason"/>
            </not>
        </preConditions>

        <createTable tableName="brand_rejection_reason"
                     remarks="BrandRejectionReasonRoot aggregate — moderator rejection records for brands">
            <column name="id" type="UUID" remarks="Primary key">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_brand_rejection_reason"/>
            </column>
            <column name="brand_id" type="UUID" remarks="Rejected brand reference (immutable after creation)">
                <constraints nullable="false"
                             foreignKeyName="fk_brand_rejection_reason_brand"
                             references="brand(id)"/>
            </column>
            <column name="reason" type="TEXT" remarks="Moderator-supplied rejection explanation">
                <constraints nullable="false"/>
            </column>

            <column name="solved" type="bool" remarks="Merchant solved this reason">
                <constraints nullable="false" />
            </column>

            <column name="moderated_by" type="UUID" remarks="Moderator ID who issued the rejection (immutable)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1" remarks="Optimistic lock version">
                <constraints nullable="false"/>
            </column>
            <column name="process_status" type="VARCHAR(20)" defaultValue="COMPLETED"
                    remarks="Outbox process state: IN_PROGRESS | FAILED | COMPLETED | ROLL_BACKED">
                <constraints nullable="false"/>
            </column>
            <column name="row_status" type="VARCHAR(20)" defaultValue="ACTIVE"
                    remarks="Logical lifecycle: ACTIVE | HIDDEN | ARCHIVED | DELETED">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ" remarks="Record creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ" remarks="Last modification timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="brand_rejection_reason"/>
        </rollback>
    </changeSet>

    <changeSet id="002-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_brand_rejection_reason_brand_id"/>
            </not>
        </preConditions>

        <createIndex tableName="brand_rejection_reason" indexName="idx_brand_rejection_reason_brand_id">
            <column name="brand_id"/>
        </createIndex>

        <createIndex tableName="brand_rejection_reason" indexName="idx_brand_rejection_reason_moderated_by">
            <column name="moderated_by"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="brand_rejection_reason" indexName="idx_brand_rejection_reason_brand_id"/>
            <dropIndex tableName="brand_rejection_reason" indexName="idx_brand_rejection_reason_moderated_by"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
