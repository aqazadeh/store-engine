<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        SpecificationCategoryAssignment (Set<> inside ProductSpecificationRoot).
        Maps which categories a specification belongs to, and whether it is required for that category.
    -->
    <changeSet id="005-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_specification_category_assignment"/>
            </not>
        </preConditions>

        <createTable tableName="product_specification_category_assignment"
                     remarks="Join table — SpecificationCategoryAssignment inside ProductSpecificationRoot">
            <column name="specification_id" type="UUID" remarks="FK to product_specification">
                <constraints nullable="false"
                             foreignKeyName="fk_spec_cat_asgn_specification"
                             references="product_specification(id)"/>
            </column>
            <column name="category_id" type="UUID" remarks="FK to product_category">
                <constraints nullable="false"
                             foreignKeyName="fk_spec_cat_asgn_category"
                             references="product_category(id)"/>
            </column>
            <column name="is_required" type="BOOLEAN" defaultValueBoolean="false"
                    remarks="Whether this specification is mandatory for products in the category">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="product_specification_category_assignment"
                columnNames="specification_id, category_id"
                constraintName="pk_product_specification_category_assignment"/>

        <rollback>
            <dropTable tableName="product_specification_category_assignment"/>
        </rollback>
    </changeSet>

    <changeSet id="005-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_spec_cat_asgn_category_id"/>
            </not>
        </preConditions>

        <createIndex tableName="product_specification_category_assignment"
                     indexName="idx_spec_cat_asgn_category_id">
            <column name="category_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_specification_category_assignment"
                       indexName="idx_spec_cat_asgn_category_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
