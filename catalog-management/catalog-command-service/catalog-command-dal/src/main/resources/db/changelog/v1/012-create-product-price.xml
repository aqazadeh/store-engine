<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="012-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_price"/>
            </not>
        </preConditions>

        <createTable tableName="product_price"
                     remarks="ProductPriceRoot aggregate — allowed price range for a product variant">
            <column name="id" type="UUID" remarks="Primary key">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_product_price"/>
            </column>
            <column name="variant_id" type="UUID"
                    remarks="Owning product variant (1-to-1, immutable, FK to product_variant)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_product_price_variant"
                             foreignKeyName="fk_product_price_variant"
                             references="product_variant(id)"/>
            </column>
            <!-- Money value object is a plain BigDecimal — no currency field in the domain model -->
            <column name="min_price" type="NUMERIC(19, 4)" remarks="Minimum allowed selling price">
                <constraints nullable="false"/>
            </column>
            <column name="max_price" type="NUMERIC(19, 4)" remarks="Maximum allowed selling price">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1" remarks="Optimistic lock version">
                <constraints nullable="false"/>
            </column>
            <column name="process_status" type="VARCHAR(20)" defaultValue="COMPLETED"
                    remarks="Outbox process state: IN_PROGRESS | FAILED | COMPLETED | ROLL_BACKED">
                <constraints nullable="false"/>
            </column>
            <column name="row_status" type="VARCHAR(20)" defaultValue="ACTIVE"
                    remarks="Logical lifecycle: ACTIVE | HIDDEN | ARCHIVED | DELETED">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ" remarks="Record creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ" remarks="Last modification timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="product_price"/>
        </rollback>
    </changeSet>

    <changeSet id="012-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_product_price_row_status"/>
            </not>
        </preConditions>

        <createIndex tableName="product_price" indexName="idx_product_price_row_status">
            <column name="row_status"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_price" indexName="idx_product_price_row_status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
