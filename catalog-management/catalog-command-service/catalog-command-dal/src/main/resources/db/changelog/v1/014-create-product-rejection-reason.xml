<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_rejection_reason"/>
            </not>
        </preConditions>

        <createTable tableName="product_rejection_reason"
        >
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_product_rejection_reason"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="process_status" type="process_status">
                <constraints nullable="false"/>
            </column>
            <column name="row_status" type="row_status_type">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>

            <column name="product_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_product_rejection_reason_product"
                             references="product(id)"/>
            </column>
            <column name="reason" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="moderated_by" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="product_rejection_reason"/>
        </rollback>
    </changeSet>

    <changeSet id="014-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_product_rejection_reason_product_id"/>
            </not>
        </preConditions>

        <createIndex tableName="product_rejection_reason"
                     indexName="idx_product_rejection_reason_product_id">
            <column name="product_id"/>
        </createIndex>

        <createIndex tableName="product_rejection_reason"
                     indexName="idx_product_rejection_reason_moderated_by">
            <column name="moderated_by"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_rejection_reason"
                       indexName="idx_product_rejection_reason_product_id"/>
            <dropIndex tableName="product_rejection_reason"
                       indexName="idx_product_rejection_reason_moderated_by"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
