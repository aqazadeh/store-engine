<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_stock"/>
            </not>
        </preConditions>

        <createTable tableName="product_stock">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_product_stock"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="process_status" type="process_status">
                <constraints nullable="false"/>
            </column>
            <column name="row_status" type="row_status_type">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>

            <column name="variant_id" type="UUID">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_product_stock_variant"
                             foreignKeyName="fk_product_stock_variant"
                             references="product_variant(id)"/>
            </column>
            <column name="quantity" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false" checkConstraint="quantity >= 0"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="product_stock"/>
        </rollback>
    </changeSet>

    <changeSet id="013-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_product_stock_row_status"/>
            </not>
        </preConditions>

        <createIndex tableName="product_stock" indexName="idx_product_stock_row_status">
            <column name="row_status"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_stock" indexName="idx_product_stock_row_status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
