<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        ProductVariantRoot (NoAggregateRoot — no version/process_status/row_status).
        Owned by ProductRoot; represents a concrete combination of variant key-value pairs.
    -->
    <changeSet id="010-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_variant"/>
            </not>
        </preConditions>

        <createTable tableName="product_variant"
                     remarks="ProductVariantRoot (NoAggregateRoot) — concrete variant of a product">
            <column name="id" type="UUID" remarks="Primary key">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_product_variant"/>
            </column>
            <column name="product_id" type="UUID" remarks="Owning product aggregate (FK to product)">
                <constraints nullable="false"
                             foreignKeyName="fk_product_variant_product"
                             references="product(id)"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ" remarks="Record creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ" remarks="Last modification timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="product_variant"/>
        </rollback>
    </changeSet>

    <changeSet id="010-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_product_variant_product_id"/>
            </not>
        </preConditions>

        <createIndex tableName="product_variant" indexName="idx_product_variant_product_id">
            <column name="product_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_variant" indexName="idx_product_variant_product_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
