<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_category"/>
            </not>
        </preConditions>

        <createTable tableName="product_category"
                     remarks="ProductCategoryRoot aggregate — hierarchical tree of product categories">
            <column name="id" type="UUID" remarks="Primary key">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_product_category"/>
            </column>
            <column name="parent_id" type="UUID"
                    remarks="Parent category ID for tree hierarchy; NULL for root categories">
                <constraints foreignKeyName="fk_product_category_parent"
                             references="product_category(id)"/>
            </column>
            <column name="name" type="VARCHAR(40)" remarks="Category display name (4–40 chars)">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="VARCHAR(40)" remarks="URL-friendly slug (4–40 chars, unique)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_product_category_path"/>
            </column>
            <column name="description" type="VARCHAR(200)" remarks="Category description (10–200 chars)">
                <constraints nullable="false"/>
            </column>
            <column name="image" type="VARCHAR(512)" remarks="Image file reference path"/>
            <column name="version" type="BIGINT" defaultValueNumeric="1" remarks="Optimistic lock version">
                <constraints nullable="false"/>
            </column>
            <column name="process_status" type="VARCHAR(20)" defaultValue="COMPLETED"
                    remarks="Outbox process state: IN_PROGRESS | FAILED | COMPLETED | ROLL_BACKED">
                <constraints nullable="false"/>
            </column>
            <column name="row_status" type="VARCHAR(20)" defaultValue="ACTIVE"
                    remarks="Logical lifecycle: ACTIVE | HIDDEN | ARCHIVED | DELETED">
                <constraints nullable="false"/>
            </column>
            <column name="creation_ts" type="TIMESTAMPTZ" remarks="Record creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="modification_ts" type="TIMESTAMPTZ" remarks="Last modification timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="product_category"/>
        </rollback>
    </changeSet>

    <changeSet id="003-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_product_category_parent_id"/>
            </not>
        </preConditions>

        <createIndex tableName="product_category" indexName="idx_product_category_parent_id">
            <column name="parent_id"/>
        </createIndex>

        <createIndex tableName="product_category" indexName="idx_product_category_row_status">
            <column name="row_status"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_category" indexName="idx_product_category_parent_id"/>
            <dropIndex tableName="product_category" indexName="idx_product_category_row_status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
