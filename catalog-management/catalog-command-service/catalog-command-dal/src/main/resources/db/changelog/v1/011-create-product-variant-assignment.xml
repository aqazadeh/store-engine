<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        ProductVariantAssignment (List<> inside ProductVariantRoot).
        Each row binds one variant dimension (key) to a concrete value for a specific product variant.
        A variant can have at most one value per key — enforced by the PK on (variant_id, variant_key_id).
    -->
    <changeSet id="011-1" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_variant_assignment"/>
            </not>
        </preConditions>

        <createTable tableName="product_variant_assignment"
                     remarks="Join table — ProductVariantAssignment inside ProductVariantRoot">
            <column name="variant_id" type="UUID" remarks="Owning product variant (FK to product_variant)">
                <constraints nullable="false"
                             foreignKeyName="fk_variant_asgn_variant"
                             references="product_variant(id)"/>
            </column>
            <column name="variant_key_id" type="UUID" remarks="Variant dimension (FK to variant_key)">
                <constraints nullable="false"
                             foreignKeyName="fk_variant_asgn_key"
                             references="variant_key(id)"/>
            </column>
            <column name="variant_value_id" type="UUID" remarks="Concrete value for the dimension (FK to variant_value)">
                <constraints nullable="false"
                             foreignKeyName="fk_variant_asgn_value"
                             references="variant_value(id)"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="product_variant_assignment"
                columnNames="variant_id, variant_key_id"
                constraintName="pk_product_variant_assignment"/>

        <rollback>
            <dropTable tableName="product_variant_assignment"/>
        </rollback>
    </changeSet>

    <changeSet id="011-2" author="rovshan.aghayev">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_variant_asgn_key_id"/>
            </not>
        </preConditions>

        <createIndex tableName="product_variant_assignment" indexName="idx_variant_asgn_key_id">
            <column name="variant_key_id"/>
        </createIndex>

        <createIndex tableName="product_variant_assignment" indexName="idx_variant_asgn_value_id">
            <column name="variant_value_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="product_variant_assignment" indexName="idx_variant_asgn_key_id"/>
            <dropIndex tableName="product_variant_assignment" indexName="idx_variant_asgn_value_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
